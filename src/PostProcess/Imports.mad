import IO from "IO"
import List from "List"

import VFile from "spirit-gum/VFile"



export processImports = (path, _lines, _state) => {
  joint = pipe(
    List.zip(_state.importHeads),
    map(
      where {
        #[#[start, isType], #[end, fromPath]] =>
          #[fromPath, isType, #[start, end], List.slice(start, end, _lines)]
      },
    ),
  )(_state.importTails)
  IO.pTrace("JOIN", joint)
  return VFile.ConcreteFile(path, _lines, _state)
}
