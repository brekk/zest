import { Nothing } from "Maybe"
import String from "String"

import Rule from "spirit-gum/Rule"
import Transformer from "spirit-gum/Rule/Transformer"

import CString from "@/String"
import TypeDef from "@/Type"



captureTypeOrAlias = (regex, aliased, state, index, line) => {
  match = String.match(regex, line)
  return if (match) {
    #[
      pipe(
        String.trim,
        String.replace(regex, "$1<><>$2"),
        String.split("<><>"),
        map(String.trim),
        where {
          [_exported, typeDef] =>
            (
              {
                ...state,
                types: [
                  ...state.types,
                  TypeDef.aliased(aliased)(
                    _exported != "",
                    typeDef,
                    typeDef,
                    #[index, -1],
                    Nothing,
                  ),
                ],
              }
            )

          _ =>
            state
        },
      )(line),
      line,
    ]
  } else {
    #[state, line]
  }
}

captureTypes = captureTypeOrAlias(CString.REGEX.CAPTURING.TYPES, false)
captureAliases = captureTypeOrAlias(CString.REGEX.CAPTURING.ALIAS, true)

export ruleTypes = Rule.lineRule(false, "zest/type", [], [Transformer.ofLineRaw(captureTypes)])

export ruleAliases = Rule.lineRule(
  false,
  "zest/type-alias",
  [],
  [Transformer.ofLineRaw(captureAliases)],
)

export rules = [ruleTypes, ruleAliases]
