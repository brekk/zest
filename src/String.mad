import Compare from "Compare"
import Fn from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe, isJust } from "Maybe"
import { charAt, length } from "String"
import String from "String"
import { Wish } from "Wish"



export capitalize = Fn.when(
  pipe(
    String.length,
    Compare.lt(0),
  ),
  (s) => pipe(
      String.slice(0, 1),
      String.toUpper,
    )(s)
      ++ String.slice(1, String.length(s), s),
)

export REGEX = {
  NON_WORD_AND_SPACES: "[\\W\\s]",
  COMMA_SPACE_CLOSED: ",\\s\\)",
  LEADING_EXPORT: "^export\\>",
  TYPE: "\\<type\\>",
  ALIAS: "\\<alias\\>",
  CAPTURING: {
    HEADING: "^(#*)\\s*(.*)",
    MADLIB_FILE: "\\b([\\w\\/\\.]*)\\.mad",
    LIST_ITEM: " - (\\w*)",
    TYPE_SIGNATURE: "^(.*)::\\s?(.*)",
    ASSIGNMENT: "^(export)?\\s?([.\\S]*)\\s?\\=\\s?(.*)",
    TYPES: "^(export)?\\s?type\\s?(.*)",
    TYPES_COMPLETE: "^(export)?\\s?(type\\|alias)\\>\\s?(.*)\\s?\\=\\s?(.*)",
    ALIAS: "^(export)?\\s?alias\\>\\s?(.*)",
    IMPORT: "^import\\s?(type)?\\s?([{}.,]*)\\s?from\\s?(.*)",
  },
}

export removeTrailingComma = String.replace(REGEX.COMMA_SPACE_CLOSED, " )")

export slug = pipe(
  String.toLower,
  capitalize,
  String.trim,
  String.replace(REGEX.NON_WORD_AND_SPACES, " "),
)

export hasMadlibFile = String.match(REGEX.CAPTURING.MADLIB_FILE)
export replaceMadlibFileByPattern = String.replace(REGEX.CAPTURING.MADLIB_FILE)
export hasSlash = String.contains("/")

export linkMadFilesToDomainWithPath = (domain, path, _, _, line) => Fn.when(
  hasMadlibFile,
  Fn.ifElse(
    hasSlash,
    replaceMadlibFileByPattern("[$1.mad](" ++ domain ++ path ++ "/$1.mad)"),
    replaceMadlibFileByPattern("[$1.mad](" ++ domain ++ path ++ "/src/$1.mad)"),
  ),
)(line)


export linkMadFilesToGithub = linkMadFilesToDomainWithPath("//github.com")

export isCommented = String.startsWith("//")
export isUncommented = Fn.complement(isCommented)


export isUnclosedOpen = Fn.both(Fn.complement(String.contains(`)`)), String.startsWith(`(`))
export isUnopenedClose = Fn.both(Fn.complement(String.contains(`(`)), String.endsWith(`)`))

isSignature :: String -> Boolean
export isSignature = Fn.both(String.contains("::"), isUncommented)



collapseParensBy :: (List String -> String) -> List String -> List String
export collapseParensBy = (joiner, raw) => {
  helper = (processed, current, xs) => where(xs) {
    [] =>
      processed

    [a, ...z] =>
      // ensure that that we check for balanced parens, so we don't affect shit like `Line (Rule a)`
      // but we do handle `end)` and `(start` cases
      if (isUnopenedClose(a)) {
        // if it closes, move it to processed
        helper([...processed, joiner([...current, a])], [], z)
      } else if (isUnclosedOpen(a)) {
        // if it opens, keep iterating in current
        helper(processed, [a], z)
      } else if (!List.isEmpty(current)) {
        // if current is present and has values, keep building it
        helper(processed, [...current, a], z)
      } else {
        // otherwise treat it as a processed value
        helper([...processed, a], current, z)
      }
  }
  return helper([], [], raw)
}

export collapseSignatureParens = collapseParensBy(String.join(" -> "))

// TODO: make this cross-env and move to prelude

indexOfAfter :: Integer -> Char -> String -> Integer
export indexOfAfter = (h, ch, _str) => {
  max = length(_str)
  helper :: Integer -> Integer -> List Char -> Integer
  helper = (matched, i, xs) => if (matched > -1 || i > max) {
    matched
  } else do {
    j = i + 1
    return where(xs) {
      [] =>
        matched

      [a, ...z] =>
        helper(a == ch ? i : matched, j, z)
    }
  }

  return helper(-1, h, List.slice(h, String.length(_str), String.toList(_str)))
}
indexOfAfterWhile :: Integer -> Char -> String -> Integer
export indexOfAfterWhile = (h, ch, str) => {
  i = h
  matched = -1
  while(matched < 0 && i <= length(str)) do {
    check = pipe(
      charAt(i),
      map(Fn.equals(ch)),
      fromMaybe(false),
    )(str)
    if (check) do {
      matched := i
    } else do {
      i := i + 1
    }
  }
  return matched
}

indexOf :: Char -> String -> Integer
export indexOf = indexOfAfter(0)
